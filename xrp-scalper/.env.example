# Binance API Keys - احصل عليها من https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# وضع التداول: true = تجريبي (Testnet), false = حقيقي
TESTNET=true

# إعدادات رأس المال
TRADE_AMOUNT_USDT=10        # مبلغ كل صفقة بالـ USDT
MAX_OPEN_TRADES=3           # عدد الصفقات المفتوحة في نفس الوقت
MAX_DAILY_LOSS_USDT=30      # أقصى خسارة يومية قبل إيقاف البوت

# إعدادات إدارة المخاطر
STOP_LOSS_PERCENT=0.5       # وقف الخسارة %
TAKE_PROFIT_PERCENT=1.0     # هدف الربح %
