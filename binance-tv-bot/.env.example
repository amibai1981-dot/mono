# ===== Binance API =====
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# testnet = true للتجربة بدون أموال حقيقية
BINANCE_TESTNET=false

# spot | futures
BINANCE_MARKET=spot

# ===== Webhook Server =====
# كلمة سر سرية — ضعها في تنبيهات TradingView داخل حقل "secret"
WEBHOOK_SECRET=change_this_to_a_long_random_string

PORT=8080
HOST=0.0.0.0

# ===== Logs =====
LOG_DIR=logs
