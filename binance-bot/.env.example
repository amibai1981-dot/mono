# مفاتيح Binance API
BINANCE_API_KEY=ضع_مفتاح_API_هنا
BINANCE_SECRET_KEY=ضع_المفتاح_السري_هنا

# البيئة: testnet للاختبار، mainnet للتداول الحقيقي
BINANCE_ENV=testnet

# إعدادات التداول
SYMBOL=BTCUSDT          # زوج العملة
TRADE_AMOUNT=10         # مبلغ التداول بالدولار لكل صفقة

# إعدادات RSI
RSI_PERIOD=14
RSI_OVERBOUGHT=70       # بيع عند هذا المستوى
RSI_OVERSOLD=30         # شراء عند هذا المستوى

# إعدادات EMA
EMA_FAST=9              # المتوسط المتحرك السريع
EMA_SLOW=21             # المتوسط المتحرك البطيء

# تحديث كل N ثانية
REFRESH_SECONDS=60
