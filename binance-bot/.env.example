# Binance API Keys
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading Mode: LIVE or PAPER (paper trading for testing)
TRADING_MODE=PAPER

# Risk Management
MAX_POSITION_SIZE_USDT=100       # Max USDT per trade
MAX_OPEN_POSITIONS=3             # Max simultaneous positions
RISK_PER_TRADE_PERCENT=1.0       # Risk % of total capital per trade
STOP_LOSS_PERCENT=2.0            # Stop loss %
TAKE_PROFIT_PERCENT=4.0          # Take profit %
TRAILING_STOP_PERCENT=1.5        # Trailing stop %

# Trading Pairs (comma separated)
TRADING_PAIRS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT

# Timeframe
TIMEFRAME=15m

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
