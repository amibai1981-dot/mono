# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Bybit ────────────────────────────────────────────────────────────────────
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_PRIVATE_KEY_PATH=./private.pem
BYBIT_ENV=testnet                  # testnet | mainnet

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=change_this_to_a_long_random_secret

# ── Risk Management ───────────────────────────────────────────────────────────
MAX_TRADE_SIZE_USDT=100            # Maximum trade size in USDT
RISK_PER_TRADE_PCT=1               # % of balance to risk per trade

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FILE=tradingview_bot.log
