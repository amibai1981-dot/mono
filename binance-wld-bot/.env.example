# Binance API credentials (never commit the real .env file)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Risk settings (optional – defaults shown)
TRADE_USDT=20          # Dollar amount per trade
STOP_LOSS_PCT=2.0      # Stop-loss percentage
TAKE_PROFIT_PCT=4.0    # Take-profit percentage
MAX_OPEN_TRADES=1      # Max concurrent positions
